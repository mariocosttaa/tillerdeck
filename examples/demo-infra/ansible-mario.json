{
  "$schema": "https://raw.githubusercontent.com/mariocosttaa/ansible-mario/main/schema/v2.json",
  "environments": [
    {
      "color": "staging",
      "id": "staging",
      "inventory": "inventories/staging.ini",
      "label": "Staging",
      "protected": false,
      "release": "releases/staging.yml"
    },
    {
      "color": "production",
      "id": "production",
      "inventory": "inventories/production.ini",
      "label": "Production",
      "protected": true,
      "release": "releases/production.yml"
    }
  ],
  "name": "Demo",
  "operations": [
    {
      "action": {
        "make": "deploy-backup-{env}"
      },
      "description": "the backup service · 30-backup",
      "destructive": false,
      "group": "backup",
      "id": "deploy-backup",
      "label": "Install backup"
    },
    {
      "action": {
        "make": "restore-{env}"
      },
      "description": "rehearse a restore on staging · SNAPSHOT=latest SCOPE=all|db|storage",
      "destructive": true,
      "group": "backup",
      "id": "restore",
      "label": "Restore"
    },
    {
      "action": {
        "make": "provision-system-{env}"
      },
      "description": "system, swap and Docker · 01-prepare-machine",
      "destructive": false,
      "group": "machine",
      "id": "provision-system",
      "label": "Provision system"
    },
    {
      "action": {
        "make": "ping-{env}"
      },
      "description": "does the machine answer?",
      "destructive": false,
      "group": "verify",
      "id": "ping",
      "label": "Ping"
    }
  ],
  "products": [
    {
      "description": "the example app",
      "id": "demo",
      "label": "Demo",
      "services": [
        {
          "actions": {
            "deploy": {
              "make": "deploy-demo-nestjs-{env}"
            },
            "migrate": {
              "make": "run-migrations-demo-nestjs-{env}"
            }
          },
          "container": "demo-api",
          "id": "api",
          "image": "demo-api",
          "kind": "nestjs",
          "label": "demo-api",
          "perEnvImage": false,
          "releaseKey": "api_tag",
          "versions": {
            "source": "registry",
            "tagFormat": "{version}-{commit}-{build}"
          }
        },
        {
          "actions": {
            "deploy": {
              "make": "deploy-demo-nextjs-{env}"
            },
            "maintenanceOff": {
              "make": "maintenance-off-demo-nextjs-{env}"
            },
            "maintenanceOn": {
              "make": "maintenance-on-demo-nextjs-{env}"
            }
          },
          "container": "demo-web",
          "id": "app",
          "image": "demo-web",
          "kind": "nextjs",
          "label": "demo-web",
          "perEnvImage": true,
          "releaseKey": "app_tag",
          "versions": {
            "source": "registry",
            "tagFormat": "{version}-{env}-{commit}-{build}"
          }
        },
        {
          "actions": {
            "deploy": {
              "make": "deploy-demo-nginx-{env}"
            }
          },
          "description": "nginx in front of the API",
          "id": "nginx",
          "kind": "nginx",
          "label": "nginx",
          "perEnvImage": false
        },
        {
          "actions": {
            "deploy": {
              "make": "deploy-demo-postgres-{env}"
            }
          },
          "description": "the database",
          "id": "postgres",
          "kind": "postgres",
          "label": "Postgres",
          "perEnvImage": false
        },
        {
          "actions": {
            "deploy": {
              "make": "deploy-demo-redis-{env}"
            }
          },
          "description": "the job queue",
          "id": "redis",
          "kind": "redis",
          "label": "Redis",
          "perEnvImage": false
        }
      ]
    }
  ],
  "promotion": [
    {
      "from": "staging",
      "to": "production"
    }
  ],
  "template": "makefile-convention",
  "version": 2,
  "registry": {
    "url": "https://registry.example.com"
  }
}
